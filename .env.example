# Environment Variables for Supabase Authentication

# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase service role key (KEEP SECRET - server-side only)
# Only use this for admin operations, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# SMTP EMAIL CONFIGURATION (for password reset codes)
# =====================================================

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail: Use App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email From Details
SMTP_FROM_NAME=Khati Family
SMTP_FROM_EMAIL=noreply@khatifamily.com

# =====================================================
# OPTIONAL: PRODUCTION CONFIGURATION
# =====================================================

# Production site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://www.khatifamily.com

# =====================================================
# SMTP SETUP INSTRUCTIONS
# =====================================================
# 
# GMAIL SETUP:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-character password in SMTP_PASSWORD above
# 5. Use your Gmail address in SMTP_USER
#
# OTHER EMAIL PROVIDERS:
# - Outlook/Hotmail: smtp-mail.outlook.com, port 587
# - Yahoo: smtp.mail.yahoo.com, port 587
# - SendGrid: smtp.sendgrid.net, port 587
# - Mailgun: smtp.mailgun.org, port 587
# - AWS SES: email-smtp.{region}.amazonaws.com, port 587
#
# For production, consider using a transactional email service:
# - SendGrid (free tier: 100 emails/day)
# - Mailgun (free tier: 5,000 emails/month)
# - AWS SES (very affordable)
# - Postmark (100 emails/month free)

# =====================================================
# NOTES
# =====================================================
# 
# 1. After setting up your Supabase project, run the migration files:
#    - Go to Supabase Dashboard > SQL Editor
#    - Run 001_initial_auth_setup.sql
#    - Run 003_password_reset_codes.sql
#    - Follow instructions in 002_oauth_setup_instructions.sql
#
# 2. Configure OAuth providers in Supabase Dashboard:
#    - Authentication > Providers
#    - Enable and configure Google, Facebook
#
# 3. Set redirect URLs in Supabase Dashboard:
#    - Authentication > URL Configuration
#    - Add: http://localhost:3000/auth/callback (for development)
#    - Add: https://your-domain.com/auth/callback (for production)
#
# 4. For local development, you can use:
#    NEXT_PUBLIC_SITE_URL=http://localhost:3000
